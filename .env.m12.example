# ADD to Render Environment, not to git-tracked real .env files
APP_MODE=staging
STAGING_ENABLE_FORMS=true
STAGING_ENABLE_ACCOUNTS=true
STAGING_ENABLE_DRAFT_FILES=true
STAGING_ENABLE_SELF_TEST=true
ENABLE_REAL_SEND=false
SELF_TEST_OWNER_EMAIL=your_verified_email@example.com

# Reuse your existing Milestone 10/11 Supabase / DB / Storage secrets.
# Gmail OAuth credentials come from Google Cloud, NOT Supabase.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret
# Optional alternative:
# MICROSOFT_CLIENT_ID=your_existing_personal_microsoft_client_id
# MICROSOFT_CLIENT_SECRET=your_existing_microsoft_client_secret
