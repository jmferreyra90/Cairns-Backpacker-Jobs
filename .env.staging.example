# Copy values to Render > Environment. Never commit real secrets.
APP_MODE=staging
STAGING_USERNAME=owner
STAGING_PASSWORD=REPLACE_WITH_24_PLUS_RANDOM_CHARACTERS
APP_SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
STAGING_ENABLE_FORMS=false
ENABLE_REAL_SEND=false
ENABLE_LOCAL_ADMIN=false
DATABASE_URL=postgresql+psycopg://YOUR_SUPABASE_SESSION_POOLER_URI
