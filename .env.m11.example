# Add these to Render -> Environment. NEVER commit real values.
APP_MODE=staging
STAGING_ENABLE_FORMS=true
STAGING_ENABLE_ACCOUNTS=true
STAGING_ENABLE_DRAFT_FILES=true
ENABLE_REAL_SEND=false
ENABLE_LOCAL_ADMIN=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_REPLACE_IN_RENDER_ONLY
CV_CLEANUP_TOKEN=GENERATE_48_BYTE_RANDOM_TOKEN
# Keep existing APP_PUBLIC_URL, DATABASE_URL, APP_SESSION_SECRET,
# STAGING_USERNAME and STAGING_PASSWORD from Milestone 10.
