# Add these in Render -> Environment, not to a committed .env file.
APP_MODE=staging
STAGING_ENABLE_FORMS=true
STAGING_ENABLE_ACCOUNTS=false
ENABLE_REAL_SEND=false
ENABLE_LOCAL_ADMIN=false
APP_SESSION_SECRET=REPLACE_WITH_CURRENT_32_PLUS_CHARACTER_SECRET
STAGING_USERNAME=owner
STAGING_PASSWORD=REPLACE_WITH_CURRENT_PASSWORD
DATABASE_URL=postgresql+psycopg://YOUR_SUPABASE_POOLER_CONNECTION
APP_PUBLIC_URL=https://YOUR-RENDER-SERVICE.onrender.com
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
